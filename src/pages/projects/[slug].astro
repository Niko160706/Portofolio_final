---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { projects, type ProjectData } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const cs = project.caseStudy;
---

<CaseStudyLayout project={project}>
  <article class="case-study-article">
    <header class="cs-article-header">
      <div class="doc-meta-row">
        <span class="doc-tag doc-tag--blue">{project.category}</span>
        <span class="doc-tag doc-tag--green">{project.status}</span>
        <span class="doc-tag">Updated {project.updatedAt}</span>
      </div>

      <h1 class="cs-headline">{project.title}</h1>
      <p class="cs-summary-lead">{project.summary}</p>

      <dl class="cs-spec-box">
        <div class="spec-item">
          <dt class="spec-label">Role</dt>
          <dd class="spec-val">{project.myRole}</dd>
        </div>
        {project.teamSize && (
          <div class="spec-item">
            <dt class="spec-label">Team</dt>
            <dd class="spec-val">{project.teamSize} developers</dd>
          </div>
        )}
        <div class="spec-item">
          <dt class="spec-label">Stack</dt>
          <dd class="spec-val">{project.technologies.join(', ')}</dd>
        </div>
      </dl>
    </header>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">01</span> Problem Statement</h2>
      <p class="cs-paragraph">{cs.problem}</p>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">02</span> Constraints</h2>
      <ul class="cs-bullet-list">
        {cs.constraints.map((constraint) => <li>{constraint}</li>)}
      </ul>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">03</span> Architecture</h2>
      <div class="architecture-box bevel-inset">
        <span class="arch-tag">SYSTEM DATAFLOW</span>
        <code>{cs.architecture}</code>
      </div>
      <p class="cs-paragraph cs-paragraph--spaced">{cs.architectureDetails}</p>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">04</span> Contribution</h2>
      <ul class="cs-bullet-list">
        {cs.myContribution.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">05</span> Implementation Details</h2>
      <ul class="cs-bullet-list">
        {cs.implementationDetails.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">06</span> Verification</h2>
      <p class="cs-paragraph">{cs.verification}</p>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">07</span> Results</h2>
      <div class="results-box">
        <strong>Owner-reported outcome:</strong> {cs.results}
        <span class="cs-results-note">Source: the owner's local benchmark. Not independently re-run for this portfolio.</span>
      </div>
      <h3 class="cs-subheading">Evidence</h3>
      <ul class="cs-bullet-list">
        {project.evidence.map((evidence) => <li>{evidence}</li>)}
      </ul>
    </section>

    <section class="cs-section">
      <h2 class="cs-heading"><span class="cs-heading__n">08</span> Tradeoffs &amp; lessons</h2>
      <h3 class="cs-subheading">Tradeoffs</h3>
      <ul class="cs-bullet-list">
        {cs.tradeoffs.map((tradeoff) => <li>{tradeoff}</li>)}
      </ul>

      <h3 class="cs-subheading">Lessons learned</h3>
      <ul class="cs-bullet-list">
        {cs.lessons.map((lesson) => <li>{lesson}</li>)}
      </ul>
    </section>

    <section class="cs-section cs-footer-links">
      <h2 class="cs-heading"><span class="cs-heading__n">09</span> Artifacts</h2>
      <div class="action-links-row">
        {project.repoUrl && (
          <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="button button--ink">
            View repository <span aria-hidden="true">↗</span>
          </a>
        )}
        <a href="/CV_NikoRajaniSyahputra.pdf" target="_blank" rel="noopener noreferrer" class="button button--outline">
          Resume (PDF) <span aria-hidden="true">↓</span>
        </a>
        <a href="/projects/" class="button button--outline">
          Project archive <span aria-hidden="true">→</span>
        </a>
        <a href="/contact/" class="button button--outline">
          Contact <span aria-hidden="true">→</span>
        </a>
      </div>
      {project.demoNote && (
        <p class="demo-note-footer">
          <strong>Deployment status:</strong> {project.demoNote}
        </p>
      )}
    </section>
  </article>
</CaseStudyLayout>

<style>
  .case-study-article {
    display: flex;
    flex-direction: column;
    gap: clamp(34px, 4vw, 52px);
  }

  .cs-article-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: clamp(26px, 3.4vw, 42px);
    border-bottom: 2px solid var(--text-primary);
    padding-bottom: clamp(24px, 3vw, 36px);
  }

  .cs-headline {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(38px, 5.4vw, 70px);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: var(--text-primary);
  }

  .cs-summary-lead {
    max-width: 62ch;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cs-spec-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
    margin-top: 10px;
    padding: 16px 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .spec-val {
    font-family: var(--font-content);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .cs-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cs-heading {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .cs-heading__n {
    font-family: var(--font-pixel);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--accent-editorial);
    font-synthesis: none;
    -webkit-font-smoothing: none;
  }

  .cs-subheading {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
  }

  .cs-paragraph {
    max-width: 72ch;
    font-size: 15.5px;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .cs-paragraph--spaced {
    margin-top: 4px;
  }

  .cs-bullet-list {
    max-width: 72ch;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cs-bullet-list li::marker {
    color: var(--accent-editorial);
  }

  .architecture-box {
    background: #0d1117;
    border: 1px solid #2b3744;
    color: #cbd5e1;
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    gap: 7px;
    overflow-x: auto;
  }

  .arch-tag {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: #8fb6ff;
    letter-spacing: 0.06em;
  }

  .architecture-box code {
    font-family: var(--font-mono);
    color: #a5d6a7;
    white-space: normal;
  }

  .results-box {
    max-width: 72ch;
    background: #eaf4ee;
    border: 1px solid #b7d8c0;
    padding: 14px 16px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-primary);
  }

  .cs-results-note {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .action-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .action-links-row .button {
    padding: 11px 14px;
    font-size: 12px;
  }

  .demo-note-footer {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .case-study-article {
      gap: 34px;
    }

    .cs-headline {
      font-size: clamp(34px, 11vw, 52px);
    }

    .cs-spec-box {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .action-links-row .button {
      width: 100%;
    }
  }
</style>
