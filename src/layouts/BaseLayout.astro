---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/anomaly.css';
import '../styles/editorial.css';
import '../styles/document.css';
import '../styles/v3.css';
import '../styles/refinement.css';
import '../styles/moro-companion.css';
import '../styles/alter-fracture.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "THE HUMAN PROTOCOL: Niko Rajani Syahputra",
  description = "Editorial engineering portfolio of Niko Rajani Syahputra: AI systems, data workflows, and interactive web experiences."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />

    <!-- Self-hosted font files (SIL Open Font License 1.1). -->
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23111111'/><rect x='3' y='3' width='10' height='10' fill='%232d5bff'/></svg>" />
  </head>
  <body>
    <slot />
  </body>
</html>
